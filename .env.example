# Discord Bot Token — get from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# Discord Application Client ID — from Discord Developer Portal
DISCORD_CLIENT_ID=your_client_id_here

# Discord Server (Guild) ID — right-click your server → Copy ID
DISCORD_GUILD_ID=your_guild_id_here

# Admin Discord User ID — right-click your profile → Copy ID
ADMIN_DISCORD_USER_ID=your_user_id_here

# Supabase Project URL — from https://supabase.com/dashboard
SUPABASE_URL=your_supabase_project_url_here

# Supabase Anon (public) Key — from Supabase Dashboard → Settings → API
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase Service Role Key — for server-side admin operations (keep secret!)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Groq API Key — from https://console.groq.com/api-keys
GROQ_API_KEY=your_groq_api_key_here

# Groq Model to use
GROQ_MODEL=llama-3.1-70b-versatile

# Bot timezone for display
TIMEZONE=Asia/Jakarta

# Bot language for responses
BOT_LANGUAGE=id